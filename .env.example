PORT=3000
NODE_ENV=development

# Frontend Client URL for CORS in Production (e.g. https://your-banking-frontend.vercel.app)
CLIENT_URL=http://localhost:5173

# MongoDB URI (Local or MongoDB Atlas)
# Example Local: mongodb://localhost:27017/banking-ledger
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/banking-ledger?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/banking-ledger

# JWT Secret for Authentication
JWT_SECRET=your_jwt_secret_key_here

# Optional: Email Service (Nodemailer OAuth2)
EMAIL_USER=your_email@gmail.com
CLIENT_ID=your_oauth_client_id
CLIENT_SECRET=your_oauth_client_secret
REFRESH_TOKEN=your_oauth_refresh_token
